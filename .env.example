
# ==========================================
# SPICEBOX - AI RECIPE ASSISTANT
# Environment Configuration Example
# ==========================================

# Gemini API Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model
LLM_MODEL=gemini-2.0-flash

# AI Behaviour
# assist = AI only when rules are unsure
# always = AI interprets every message
LLM_MODE=assist

# Optional database configuration
# Use only if you have a hosted database URL
# DB_URL=https://your-hosted-database-url

# Optional local database path
# RECIPE_DB_PATH=data/processed/recipes.db
